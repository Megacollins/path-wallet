# Chain — defaults to Rome Hadrian (200010), resolved from @rome-protocol/registry.
# Override the RPCs only if you have your own (e.g. a private Solana RPC).
# CHAIN_ID=200010
PROXY_URL=
SOLANA_RPC=

# EVM lane wallet (a MetaMask-style key). Fund it with at least 1 USDC as its Rome
# gas balance — a demo run costs ~0.5 (fresh Vault deploy + 0.15 wrapped). Bridge
# USDC in (`rome fund`); there is no faucet. Same name the rome CLI reads.
ROME_EVM_KEY=0xYOUR_EVM_PRIVATE_KEY

# Solana lane wallet (a Phantom-style key, as the JSON secret-key array
# Phantom/solana-keygen export). Fund it with at least 0.6 USDC (the demo moves
# 0.5 through the synthetic and sweeps it back) + 0.02 SOL for tx fees.
ROME_SOLANA_KEY=[1,2,3]

# Set this after `npm run deploy` (or the demo deploys its own).
VAULT_ADDRESS=

# Set this after `npm run deploy:account` to surface the modular SmartAccount in
# the Settings page. Optional — the wallet works without it.
SMART_ACCOUNT_ADDRESS=

# ---- Starter-gas faucet (server-side only; see FAUCET.md) ----
# Treasury key the faucet server dispenses FROM. NEVER commit a real key; never
# expose it to the browser. Fund it with bridged USDC (`rome fund`).
ROME_FAUCET_KEY=0xYOUR_TREASURY_PRIVATE_KEY
# Per-claim drip + guards (optional; sensible defaults shown).
FAUCET_AMOUNT_USDC=0.75
FAUCET_MAX_RECIPIENT_USDC=0.2
FAUCET_COOLDOWN_HOURS=24
FAUCET_MAX_PER_IP_HOUR=3
FAUCET_MAX_DAILY=300
FAUCET_PORT=8787
FAUCET_ALLOW_ORIGIN=*

# ---- Frontend ---- (Vite exposes VITE_* to the browser)
# URL of your deployed faucet endpoint. Defaults to the local dev server.
VITE_FAUCET_URL=http://localhost:8787/api/faucet

# Rome bridge-api BASE URL for the in-app "Bridge USDC in" panel — HOST ONLY,
# WITHOUT /v1 (the SDK appends /v1/quote; a trailing /v1 → ".../v1/v1/quote" → 404).
# Defaults to Rome's hosted devnet instance if unset — leave as-is for Hadrian.
#   default:  https://bridge-api.devnet.romeprotocol.xyz   (Rome-hosted; the `rome` CLI uses this)
#   self-host github:rome-protocol/rome-bridge-api → e.g. http://localhost:3000
VITE_BRIDGE_API_URL=https://bridge-api.devnet.romeprotocol.xyz
